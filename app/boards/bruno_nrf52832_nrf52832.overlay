/*
 * Device Tree Overlay — Bruno nRF52832 Board
 * Animated Eye demo
 *
 * Configures:
 *   - GC9D01 160×160 round TFT display via SPI1 (MIPI DBI Type-C)
 *
 * NOTE — Flash partition:
 *   The eye graphics tables (sclera 80 KB, iris 32 KB, eyelids 32 KB,
 *   polar 13 KB) add ~160 KB of read-only data to the binary.
 *   The default slot0_partition is 220 KB, which may not be large enough
 *   when combined with LVGL and Zephyr.
 *
 *   The partition override below expands slot0 to 440 KB by absorbing
 *   slot1 (OTA update slot). This is fine for a development demo.
 *   To restore dual-slot OTA capability, revert these partition changes.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/display/panel.h>

/ {
    chosen {
        zephyr,display = &gc9d01;
    };

    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        status = "okay";
        spi-dev = <&spi1>;
        dc-gpios    = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        /*
         * GC9D01 — Waveshare 0.71" BOE 160×160 round TFT.
         * Pixel format RGB565 (16-bit), no display-inversion for this panel.
         */
        gc9d01: gc9d01@0 {
            compatible = "galaxycore,gc9d01";
            reg = <0>;
            mipi-max-frequency = <40000000>;
            pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
            width  = <160>;
            height = <160>;
        };
    };
};

/* Disable peripherals not used by this demo */
&i2c0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&spi0  { status = "disabled"; };
&adc   { status = "disabled"; };

/*
 * SPI1 — drives the GC9D01 via the MIPI DBI controller.
 * CS → P0.19 (active LOW), SCK → P0.11, MOSI → P0.12.
 */
&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    #address-cells = <1>;
    #size-cells = <0>;

    cs-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;

    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
};

/*
 * Pin multiplexer for SPI1.
 * SCK → P0.11, MOSI → P0.12, MISO → P0.13 (unused, display is write-only).
 */
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 11)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 12)>,
                    <NRF_PSEL(SPIM_MISO, 0, 13)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK,  0, 11)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 12)>,
                    <NRF_PSEL(SPIM_MISO, 0, 13)>;
            low-power-enable;
        };
    };
};

/*
 * Flash partition override — expands the application slot to 440 KB.
 *
 * Layout (512 KB total):
 *   0x00000 – 0x0BFFF : MCUboot   (48 KB, unchanged)
 *   0x0C000 – 0x79FFF : slot0     (440 KB, application)
 *   0x7A000 – 0x7FFFF : storage   (24 KB, unchanged)
 *
 * slot1 (OTA) is removed; restore it if OTA updates are needed.
 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        boot_partition: partition@0 {
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(48)>;
        };

        slot0_partition: partition@c000 {
            label = "image-0";
            reg = <0x0000c000 DT_SIZE_K(440)>;
        };

        storage_partition: partition@7a000 {
            label = "storage";
            reg = <0x0007a000 DT_SIZE_K(24)>;
        };
    };
};
